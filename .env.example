PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/postgres
CLIENT_URL=http://localhost:5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=https://your-app.vercel.app
LIVE_SYNC_ENABLED=true
LIVE_SYNC_INTERVAL_MS=60000
# Optional: Pre-seed Telegram username → FPL team ID claims so users don't have to
# paste their FPL ID. Format is @username:FPL_ID separated by commas.
# Example: CANCHEROS_USERNAME_CLAIMS=@jane:123456,@john_doe:234567,@mike:345678
CANCHEROS_USERNAME_CLAIMS=